# Database
DATABASE_URL="postgresql://user:password@localhost:5432/studymate?schema=public"

# NextAuth
NEXTAUTH_SECRET="change-this-to-a-random-secret-string"
NEXTAUTH_URL="http://localhost:3000"

# AI Provider (OpenAI-compatible)
AI_API_KEY=
AI_API_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# File Upload
MAX_FILE_SIZE_MB=10

# Private S3-compatible object storage (required in production)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
